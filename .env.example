# Local development example (placeholders only — never real secrets).
RESTAMP_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
# Example local socket URL:
# RESTAMP_DATABASE_URL=mysql+pymysql://restamp_dev:PASSWORD@localhost/restamp_dev?unix_socket=/tmp/mysql.sock
RESTAMP_JWT_SECRET=change-me-to-a-long-random-secret
RESTAMP_JWT_EXPIRE_MINUTES=30
# RESTAMP_ENV selects the behavior class:
#   local/development      = local dev (docs on, no gate)
#   production/prod/staging= PRODUCTION (full startup security gate; "staging"
#                            is intentionally production-equivalent so a
#                            staging DB can never soften hardening)
# NOTE: "demo" is no longer a supported value (the demo OTP login was
#   removed); startup refuses it in every classification.
RESTAMP_ENV=local
RESTAMP_OTP_TTL_SECONDS=300
RESTAMP_OTP_MAX_REQUESTS_PER_HOUR=5
RESTAMP_OTP_MAX_VERIFY_ATTEMPTS=5
RESTAMP_OTP_BLOCK_SECONDS=900
# TEMPORARY internal-testing OTP DISPLAY — keep "0" unless doing local or
# internal testing while SMS delivery is still unconnected. Restamp ships
# NO SMS provider (see app/services/otp.py); OTP requests fail closed with
# a generic 503. Setting RESTAMP_OTP_DISPLAY_MODE=1 in a NON-production
# process makes /auth/otp/request include the backend-selected code
# ("debug_code") in the response so internal testers can log in without
# SMS. Production must NEVER have this enabled: production startup refuses
# the flag outright and the service re-checks the production classification
# per request, so production API responses and logs can never contain a code.
RESTAMP_OTP_DISPLAY_MODE=0

# Restricted test-only login (see app/services/test_login.py): production
# phone login WITHOUT an SMS provider, for bounded testing windows only.
# Disabled by default (flag "0" and/or empty key → /auth/test-login 404s
# like an unknown route). The key is a CREDENTIAL: generate a strong random
# value (>= 32 chars — a placeholder/short value refuses production boot),
# send it in the X-Test-Login-Key header, never in logs, and set
# RESTAMP_TEST_LOGIN_ENABLED back to "0" when testing is done. Separate
# from the OTP display mode above; no OTP is generated, returned, or logged.
RESTAMP_TEST_LOGIN_ENABLED=0
RESTAMP_TEST_LOGIN_KEY=
# Explicit test-phone allowlist (comma-separated E.164 Indian mobiles,
# e.g. "+919876543210,+919876543211"). FAIL CLOSED: empty → EVERY
# /auth/test-login attempt is rejected (403) even with a valid key.
# Phones outside the list can never log in, and no account is created
# for them. Valid-format entries only (+91 + 10 digits starting 6-9):
# malformed entries refuse production boot.
RESTAMP_TEST_LOGIN_ALLOWED_PHONES=
# Account creation via the test login (default 0 = login-only). "0":
# ONLY existing allowlisted accounts can log in — an allowlisted UNKNOWN
# phone gets the same generic 401 as a wrong key and NO account is
# created. "1": an allowlisted unknown phone may also register (mirrors
# /auth/otp/verify, recorded with verified_by="test_login").
RESTAMP_TEST_LOGIN_ALLOW_REGISTRATION=0
# Authorization MODE for the test login: "allowlist" (default — ONLY the
# phones above may use it), "existing" (each VALID Indian mobile may log
# in ONLY when a Restamp account already exists; unknown phones get 404
# "No account found for this phone number.", ZERO rows are written, and
# registration must stay off — production boot refuses that
# combination), or "suffix" (presenter convenience ONLY, strictly for a
# bounded demo window: the ONLY authorization is the LAST SIX DIGITS of
# the entered phone — predictable by design, NOT a secret — sent as a
# {phone, code} body with NO key header; active ONLY inside
# RESTAMP_TEST_LOGIN_SUFFIX_UNTIL below, existing accounts only, and
# registration must stay off — production refuses that combination).
# The allowlist above is ignored in "existing"/"suffix" modes. An
# unknown value keeps the endpoint disabled (404) and refuses
# production boot.
RESTAMP_TEST_LOGIN_MODE=allowlist
# Hard expiry for "suffix" mode ONLY (ISO-8601 UTC, e.g.
# "2026-10-29T05:00:00Z" — keep the trailing Z or an explicit offset).
# Production REQUIRES it when MODE="suffix": missing, unparseable, past,
# or more-than-24h-ahead values refuse boot, and once the moment passes
# the endpoint self-disarms to the exact inactive 404 (re-checked on
# EVERY request — no redeploy needed to end the demo window). Empty
# keeps "suffix" mode inactive everywhere (fail-closed default).
RESTAMP_TEST_LOGIN_SUFFIX_UNTIL=
RESTAMP_TEST_LOGIN_MAX_PER_HOUR_PER_IP=10
RESTAMP_TEST_LOGIN_MAX_PER_HOUR_PER_PHONE=20

RESTAMP_GOOGLE_CLIENT_ID=
RESTAMP_GOOGLE_DEV_MODE=0
# Production (Render -> Aiven MySQL, placeholders only — never real secrets):
# RESTAMP_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl-mode=REQUIRED
# Aiven CA certificate path (production only; local dev leaves this empty).
# Download ca.pem from Aiven Console -> service -> Connection information,
# mount it on Render as a Secret File, and set this to the mount path.
RESTAMP_DB_SSL_CA=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=restamp

# SMS delivery: NOT CONNECTED YET — by design, in code.
# This codebase contains no SMS vendor and no SMS configuration: the OTP
# service (app/services/otp.py) generates and verifies codes but has no
# delivery attached, so OTP requests fail closed with a generic 503 and
# phone-OTP login is unavailable. There are NO SMS environment variables;
# real SMS delivery must be implemented and attached in code (behind
# OTPService.delivery) before public login can work.
