# RESTAMP BACKEND environment (FastAPI). Placeholders only, never real values.
# Every variable below is read by app/config.py (or app/db.py, app/worker.py).
# The app does NOT load this file itself: export it into the shell (or set it
# in the host's environment) before starting uvicorn:
#   set -a && source .env && set +a && uvicorn app.main:app --reload --port 8000
# Frontend variables do NOT belong here (see the mobile and website
# .env.example files); nothing in this file is ever sent to a browser.

# =============================================================================
# PART 1: LOCAL DEVELOPMENT (copy to .env, which is gitignored)
# =============================================================================

# Required. local/development/dev/test = development; production/prod/staging
# = production hardening (staging additionally uses the testing OTP, see
# PART 3). Unset or unknown values refuse to start.
RESTAMP_ENV=local
# Required. A development RESTAMP_ENV only accepts a LOCAL database.
RESTAMP_DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/restamp_dev?unix_socket=/tmp/mysql.sock
# JWT signing secret. Use 32+ random characters (required in production).
RESTAMP_JWT_SECRET=change-me-to-a-long-random-secret
RESTAMP_JWT_EXPIRE_MINUTES=30

# --- Phone OTP ---------------------------------------------------------------
# Simplified testing OTP: there are NO OTP settings. The backend accepts one
# fixed testing code (349086, app/services/otp.py TEST_OTP) in local and
# staging only and returns it from POST /auth/otp/request as "debug_code" so
# the mobile app and website can show it. No SMS provider is integrated, so
# production fails closed: the request endpoint returns 503 and every code
# is rejected there. The removed RESTAMP_OTP_* rate-limit/display variables
# are not read anywhere; production refuses to start while the obsolete
# RESTAMP_OTP_DISPLAY_MODE=1 is still set.

# --- Optional features ---------------------------------------------------------
# Google sign-in (web). DEV_MODE=1 accepts synthetic "dev:<id>" tokens locally.
RESTAMP_GOOGLE_CLIENT_ID=
RESTAMP_GOOGLE_DEV_MODE=0
# Browser origins. Empty in development = local Expo/Next defaults plus any
# localhost / private-LAN origin.
RESTAMP_CORS_ORIGINS=
# Listing photos: Cloudinary when CLOUDINARY_CLOUD_NAME is set, otherwise
# local disk under RESTAMP_MEDIA_ROOT (default /tmp/restamp-media).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=restamp
# RESTAMP_MEDIA_ROOT=/tmp/restamp-media
# Development only: extra allowed photo-URL prefixes (ignored in production).
# RESTAMP_DEV_MEDIA_URL_PREFIXES=
# Reva chatbot (optional; without these it answers from its built-in FAQ).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
AGARAM_ENDPOINT=
# AGARAM_API_KEY=                                 # falls back to HF_TOKEN / HUGGINGFACE_API_KEY
# AGARAM_MODEL_NAME=murai-labs/agaram-2.5b-instruct
# AGARAM_ENABLED=1
# Chennai area seeding tools (paused; ignored in production).
# RESTAMP_AREA_SEEDING_ENABLED=0
# "1" stops the background auto-verification worker (the tests set it).
# RESTAMP_DISABLE_AUTO_VERIFY=0

# Test runs only (pytest; see README): use the disposable restamp_test database.
# RESTAMP_TEST_REQUIRE_DISPOSABLE=1
# RESTAMP_TEST_BLOCKED_DBS=

# =============================================================================
# PART 2: PRODUCTION (Ubuntu server or Render). Set these in the host's
# environment (PM2/systemd env, or the Render dashboard), never in git.
# =============================================================================
# RESTAMP_ENV=production
# RESTAMP_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl-mode=REQUIRED
# RESTAMP_DB_SSL_CA=/path/to/ca.pem               # required for a remote (Aiven) database
# RESTAMP_JWT_SECRET=<random, 32+ characters>
# RESTAMP_JWT_EXPIRE_MINUTES=30
# RESTAMP_CORS_ORIGINS=https://restamp.in,https://www.restamp.in
# RESTAMP_GOOGLE_CLIENT_ID=<real client id>
# RESTAMP_GOOGLE_DEV_MODE=0                       # "1" refuses to start in production
# RESTAMP_GOOGLE_ENABLED=1                        # opt in to Google login
# RESTAMP_DOCS_ENABLED=0                          # "1" makes /docs public
# CLOUDINARY_CLOUD_NAME=<name>
# CLOUDINARY_API_KEY=<key>
# CLOUDINARY_API_SECRET=<secret>
#
# PRODUCTION OTP STATUS: no SMS delivery channel exists, and the fixed
# testing OTP is refused in production. Phone OTP login is unavailable:
# POST /auth/otp/request returns 503, every code is rejected, and startup
# logs a warning. A real SMS provider must be integrated in code first.

# =============================================================================
# PART 3: STAGING / TEST DEPLOYMENT (e.g. Render behind a Vercel test site).
# Same hardening as production, plus the fixed testing OTP: every phone
# number can log in with 349086.
# =============================================================================
# RESTAMP_ENV=staging
# RESTAMP_CORS_ORIGINS=https://restamp-alpha.vercel.app
#   Must NOT list https://restamp.in or https://www.restamp.in (startup
#   refuses that combination). Never point real users at a staging backend:
#   the testing OTP lets anyone sign in as any phone number there.
# Plus the PART 2 database, JWT, Google and Cloudinary settings.
