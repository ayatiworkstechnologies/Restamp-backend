# Local development example (placeholders only — never real secrets).
RESTAMP_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
# Example local socket URL:
# RESTAMP_DATABASE_URL=mysql+pymysql://restamp_dev:PASSWORD@localhost/restamp_dev?unix_socket=/tmp/mysql.sock
RESTAMP_JWT_SECRET=change-me-to-a-long-random-secret
RESTAMP_JWT_EXPIRE_MINUTES=30
RESTAMP_OTP_DEBUG=0
RESTAMP_OTP_TTL_SECONDS=300
RESTAMP_OTP_MAX_REQUESTS_PER_HOUR=5
RESTAMP_OTP_MAX_VERIFY_ATTEMPTS=5
RESTAMP_OTP_BLOCK_SECONDS=900
RESTAMP_GOOGLE_CLIENT_ID=
RESTAMP_GOOGLE_DEV_MODE=0
