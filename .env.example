# Local development example (placeholders only — never real secrets).
RESTAMP_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
# Example local socket URL:
# RESTAMP_DATABASE_URL=mysql+pymysql://restamp_dev:PASSWORD@localhost/restamp_dev?unix_socket=/tmp/mysql.sock
RESTAMP_JWT_SECRET=change-me-to-a-long-random-secret
RESTAMP_JWT_EXPIRE_MINUTES=30
# RESTAMP_ENV selects the behavior class:
#   local/development      = local dev (dev SMS provider, docs on, no gate)
#   production/prod/staging= PRODUCTION (full startup security gate; "staging"
#                            is intentionally production-equivalent so a
#                            staging DB can never soften hardening)
#   demo                   = dedicated demo/staging deployment. Needs
#                            RESTAMP_OTP_DEMO_MODE=1 to activate the demo
#                            OTP login: each request returns the SELECTED
#                            predefined demo code (debug_code) and verifies
#                            ONLY that code (normal expiry/limits/attempt
#                            caps). Production NEVER accepts demo codes.
RESTAMP_ENV=local
RESTAMP_OTP_DEMO_MODE=0
# Demo OTP login phone allowlist (RESTAMP_ENV=demo + RESTAMP_OTP_DEMO_MODE=1):
#   comma-separated PRIVATE test phone numbers, normalized to exact E.164
#   (one leading "+", digits only; spacing tolerated). A local
#   non-production demo without it keeps the any-phone behavior (unchanged).
#   A production-classified demo deployment MUST set it: startup refuses
#   demo mode with an empty allowlist. NEVER list real user numbers here;
#   the value belongs in the host dashboard, not in code.
RESTAMP_OTP_DEMO_PHONES=
RESTAMP_OTP_DEBUG=0
RESTAMP_OTP_TTL_SECONDS=300
RESTAMP_OTP_MAX_REQUESTS_PER_HOUR=5
RESTAMP_OTP_MAX_VERIFY_ATTEMPTS=5
RESTAMP_OTP_BLOCK_SECONDS=900
RESTAMP_GOOGLE_CLIENT_ID=
RESTAMP_GOOGLE_DEV_MODE=0
# Production (Render -> Aiven MySQL, placeholders only — never real secrets):
# RESTAMP_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl-mode=REQUIRED
# Aiven CA certificate path (production only; local dev leaves this empty).
# Download ca.pem from Aiven Console -> service -> Connection information,
# mount it on Render as a Secret File, and set this to the mount path.
RESTAMP_DB_SSL_CA=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=restamp

# SMS delivery. Local dev/tests never send SMS (dev provider) regardless of
# these values. Only "msg91" is implemented as a production provider; its
# secrets belong in the Render dashboard, never in a committed file.
# RESTAMP_SMS_MODE:
#   "provider" (default) = production requires a configured provider.
#   "disabled"           = explicit TEMPORARY deferred mode: production starts
#                          WITHOUT SMS — phone-OTP login is unavailable, OTP
#                          requests fail closed (generic 503; no code is
#                          generated, sent, or disclosed), verification has
#                          no bypass.
# CURRENT STATE: MSG91 activation is deferred until Ayatiworks' DLT
#   registration, approved sender header and approved OTP template are ready;
#   production (render.yaml) sets RESTAMP_SMS_MODE=disabled.
# TO ENABLE MSG91 LATER (no code change): set RESTAMP_SMS_MODE=provider here
#   and in Render, keep RESTAMP_SMS_PROVIDER=msg91, and set the two secrets
#   in the Render dashboard.
RESTAMP_SMS_MODE=disabled
RESTAMP_SMS_PROVIDER=msg91
RESTAMP_SMS_MSG91_AUTH_KEY=
RESTAMP_SMS_MSG91_TEMPLATE_ID=
