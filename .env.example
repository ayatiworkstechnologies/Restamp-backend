# Local development example (placeholders only — never real secrets).
RESTAMP_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
# Example local socket URL:
# RESTAMP_DATABASE_URL=mysql+pymysql://restamp_dev:PASSWORD@localhost/restamp_dev?unix_socket=/tmp/mysql.sock
RESTAMP_JWT_SECRET=change-me-to-a-long-random-secret
RESTAMP_JWT_EXPIRE_MINUTES=30
# RESTAMP_ENV is REQUIRED (no default; startup refuses unset/unknown values).
# It alone decides production — the database host is never used for that:
#   local/development/dev/test = development (docs on; a LOCAL database only)
#   production/prod/staging    = PRODUCTION (full startup security gate;
#                                "staging" is intentionally production-equivalent)
# "demo" is not supported (the demo OTP login was removed); startup refuses it.
RESTAMP_ENV=local
RESTAMP_OTP_TTL_SECONDS=300
# Per phone, rolling hour; a successful login clears the phone's count.
RESTAMP_OTP_MAX_REQUESTS_PER_HOUR=10
# Wrong guesses per code; then a fixed RESTAMP_OTP_BLOCK_SECONDS block.
RESTAMP_OTP_MAX_VERIFY_ATTEMPTS=5
RESTAMP_OTP_BLOCK_SECONDS=600
# LOCAL-DEVELOPMENT OTP DISPLAY — keep "0" unless testing locally while SMS
# delivery is unconnected. Restamp ships NO SMS provider (see
# app/services/otp.py); OTP requests fail closed with a generic 503.
# RESTAMP_OTP_DISPLAY_MODE=1 with a development RESTAMP_ENV makes
# /auth/otp/request include the code ("debug_code") so developers can log
# in without SMS. Production never returns a code: startup refuses the flag,
# and the service and the auth router both re-check per request. There is
# no production override.
RESTAMP_OTP_DISPLAY_MODE=0

RESTAMP_GOOGLE_CLIENT_ID=
RESTAMP_GOOGLE_DEV_MODE=0

# Allowed browser origins (comma-separated exact origins). Development: empty
# = local Expo defaults, and localhost / private-LAN origins are also allowed.
# PRODUCTION: required, and the ONLY allowed origins — exact https origins
# with no path, no trailing slash, no "*", no localhost/LAN, e.g.
# RESTAMP_CORS_ORIGINS=https://restamp.in,https://www.restamp.in,https://restamp-alpha.vercel.app,https://restamp-app.vercel.app
RESTAMP_CORS_ORIGINS=
# Production (Render -> Aiven MySQL, placeholders only — never real secrets):
# RESTAMP_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl-mode=REQUIRED
# Aiven CA certificate path (production only; local dev leaves this empty).
# Download ca.pem from Aiven Console -> service -> Connection information,
# mount it on Render as a Secret File, and set this to the mount path.
RESTAMP_DB_SSL_CA=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=restamp

# SMS delivery: NOT CONNECTED YET — by design, in code.
# This codebase contains no SMS vendor and no SMS configuration: the OTP
# service (app/services/otp.py) generates and verifies codes but has no
# delivery attached, so OTP requests fail closed with a generic 503 and
# phone-OTP login is unavailable. There are NO SMS environment variables;
# real SMS delivery must be implemented and attached in code (behind
# OTPService.delivery) before public login can work.
