[Unit]
Description=RESTAMP FastAPI Backend Application
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=restamp
Group=restamp
WorkingDirectory=/var/www/restamp/backend

# Environment file with production secrets
EnvironmentFile=/etc/restamp/backend.env

# Execution command: run uvicorn with production worker count
ExecStart=/var/www/restamp/backend/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 4 \
    --loop uvloop \
    --http httptools \
    --no-access-log \
    --proxy-headers

# Process management & auto-restart
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true

# Filesystem permissions: Allow writes only to the storage root and logs
ReadWritePaths=/var/lib/restamp/property-photos /var/log/restamp

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
