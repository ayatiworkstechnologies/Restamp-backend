# ==============================================================================
# RESTAMP backend — production environment TEMPLATE (photo-storage relevant)
#
# This is NOT a complete production env file and holds no real values. Merge
# only the lines you need into the EXISTING env file on the server (back it
# up first; never print it). Every <PLACEHOLDER> must be replaced.
# Full variable reference: CLAUDE.md §11 and .env.example.
#
# Do NOT add any RESTAMP_OTP_* variable: those settings were removed and must
# stay removed (production refuses RESTAMP_OTP_DISPLAY_MODE). The only OTP
# setting is RESTAMP_PRODUCTION_FIXED_OTP — leave it exactly as it is today.
# ==============================================================================

RESTAMP_ENV=production

# --- Database: Aiven MySQL (remote, TLS required) ------------------------------
# Use the existing value; never paste it into tickets or logs. db.py refuses a
# remote URL without verified TLS: RESTAMP_DB_SSL_CA must point at the Aiven
# CA certificate (ca.pem from the Aiven console), readable by the service user
# and listed in the unit's ReadOnlyPaths.
# RESTAMP_DATABASE_URL=mysql+pymysql://<USER>:<PASSWORD>@<AIVEN_HOST>:<PORT>/<DB>?ssl-mode=REQUIRED
# RESTAMP_DB_SSL_CA=<PATH_TO_AIVEN_CA_PEM>

# --- Property photo storage (server disk) --------------------------------------
# New property photos go to disk; existing Cloudinary photos stay where they
# are. Startup refuses a /tmp, temporary or in-repository RESTAMP_MEDIA_ROOT.
RESTAMP_PHOTO_STORAGE=local
RESTAMP_MEDIA_ROOT=/var/www/restamp/uploads
# Public https origin that serves /media/ (the API host Nginx answers on).
RESTAMP_MEDIA_PUBLIC_BASE_URL=https://<API_HOST>
# Optional limits (defaults shown). Keep Nginx client_max_body_size >=
# RESTAMP_PHOTO_MAX_BYTES + 1 MiB (12m for the default).
# RESTAMP_PHOTO_MAX_BYTES=10485760
# RESTAMP_PHOTO_MAX_DIMENSION=10000

# --- Cloudinary: KEEP (legacy photos are still deleted through it) -------------
# CLOUDINARY_CLOUD_NAME=<existing>
# CLOUDINARY_API_KEY=<existing>
# CLOUDINARY_API_SECRET=<existing>
# CLOUDINARY_FOLDER=<existing, default restamp>

# --- Behind Nginx ----------------------------------------------------------------
RESTAMP_TRUST_PROXY=1
# RESTAMP_RATE_LIMIT_KEY=<existing; >=32 random chars, different from the JWT secret>
