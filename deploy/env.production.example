# ==============================================================================
# RESTAMP Production Environment Configuration Guide
# Location on Ubuntu: /etc/restamp/backend.env (chmod 0600, root:restamp)
# ==============================================================================

# Core environment classification
RESTAMP_ENV=production

# Database Connection (MySQL via unix socket or loopback)
RESTAMP_DATABASE_URL=mysql+pymysql://restamp_prod:<SECURE_DB_PASSWORD>@127.0.0.1:3306/restamp_prod

# JWT Authentication
RESTAMP_JWT_SECRET=<STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS>
RESTAMP_JWT_EXPIRE_MINUTES=30

# CORS Allowed Origins (Comma-separated exact HTTPS origins, no trailing slashes)
RESTAMP_CORS_ORIGINS=https://restamp.in,https://www.restamp.in,https://admin.restamp.in

# ------------------------------------------------------------------------------
# Property Photo Storage Configuration (Ubuntu Server Disk)
# ------------------------------------------------------------------------------
# Switch NEW property-photo uploads to Ubuntu server disk:
RESTAMP_PHOTO_STORAGE=local

# Canonical local storage root path on Ubuntu server:
RESTAMP_MEDIA_ROOT=/var/lib/restamp/property-photos

# Mandatory public HTTPS base URL for generated photo URLs:
# Photos will be addressed as: https://api.restamp.in/media/<listing_id>/<uuid>.<ext>
RESTAMP_MEDIA_PUBLIC_BASE_URL=https://api.restamp.in

# Configurable photo limits (defaults: 10 MB, 10000 px max dimension)
# Range: 65536 (64 KB) to 52428800 (50 MB)
RESTAMP_PHOTO_MAX_BYTES=10485760
# Range: 256 to 30000 pixels per side
RESTAMP_PHOTO_MAX_DIMENSION=10000

# ------------------------------------------------------------------------------
# Cloudinary Configuration (REQUIRED for Legacy Property Photos & Profile Photos)
# ------------------------------------------------------------------------------
# DO NOT remove or disable Cloudinary. Legacy property photos and profile photos
# continue using Cloudinary. Legacy photos are destroyed from Cloudinary on delete.
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>
CLOUDINARY_FOLDER=restamp

# ------------------------------------------------------------------------------
# Reverse Proxy & Rate Limiting (Nginx)
# ------------------------------------------------------------------------------
# Behind Nginx: trust X-Forwarded-For to extract client IP for rate limiting:
RESTAMP_TRUST_PROXY=1

# Dedicated HMAC secret for rate-limit IP hashing (minimum 32 chars, different from JWT)
RESTAMP_RATE_LIMIT_KEY=<STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS>

# OTP Configuration
RESTAMP_OTP_TTL_SECONDS=300
RESTAMP_OTP_MAX_REQUESTS_PER_HOUR=5
RESTAMP_OTP_MAX_VERIFY_ATTEMPTS=5
RESTAMP_OTP_BLOCK_SECONDS=900

# Push & Email Providers
RESTAMP_PUSH_PROVIDER=expo
RESTAMP_EXPO_ACCESS_TOKEN=<EXPO_ACCESS_TOKEN>
RESTAMP_EMAIL_PROVIDER=resend
RESTAMP_RESEND_API_KEY=<RESEND_API_KEY>
RESTAMP_EMAIL_FROM=notifications@restamp.in
RESTAMP_EMAIL_FROM_NAME=RESTAMP
